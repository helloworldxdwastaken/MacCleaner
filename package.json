{
  "name": "maccleaner",
  "version": "2.0.0",
  "description": "MacCleaner — a macOS cleaner suite (Smart Scan, Performance, Maintenance, Uninstaller, Updater, Fan Control) with a GrandPerspective-style disk treemap",
  "author": "dronx <info.dronx@gmail.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "build:helper": "bash native/fanhelper/build.sh",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build:helper && npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.dronx.maccleaner",
    "productName": "MacCleaner",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "helloworldxdwastaken",
      "repo": "MacCleaner"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "native/fanhelper/build/maccleaner-fanhelperd",
          "to": "fanhelper/maccleaner-fanhelperd"
        },
        {
          "from": "native/fanhelper/install.sh",
          "to": "fanhelper/install.sh"
        },
        {
          "from": "native/fanhelper/uninstall.sh",
          "to": "fanhelper/uninstall.sh"
        },
        {
          "from": "native/fanhelper/com.dronx.maccleaner.fanhelper.plist",
          "to": "fanhelper/com.dronx.maccleaner.fanhelper.plist"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": ["public.folder"],
            "LSHandlerRank": "Alternate"
          }
        ],
        "NSAppleEventsUsageDescription": "MacCleaner lists and manages your “Open at Login” apps via System Events, and moves files to the Trash via Finder."
      }
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
